# Local caches
.cache/
.tmp/
tmp/
local/workspaces.json
local/obsidian-runtime-acceptance.json
__pycache__/
*.py[cod]

# Editor and OS noise
.obsidian/
.DS_Store
Thumbs.db
*~
*.swp
*.swo

# Local owner decision drafts; real landing artifacts must be explicit reviewed manifests.
artifacts/manifests/*.local.jsonl

# Runtime logs and generated reports
*.log
*.trace
*.tmp
*.bak
reports/generated/

# Heavy or binary artifacts should be referenced from registry, not committed.
artifacts/raw/
artifacts/downloads/
artifacts/binaries/
*.bin
*.elf
*.hex
*.img
*.iso
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.rar

# Secret-bearing local files
.env
.env.*
*.pem
*.key
*.p12
*.pfx
