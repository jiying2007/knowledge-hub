#!/usr/bin/env bash
set -euo pipefail

# GitHub-hosted runners do not provide Codex RTK. This least-capability transport
# preserves the repository's governed command invocation contract in CI; it does
# not implement RTK filtering, telemetry, trust, network or shell-eval features.
if [[ $# -lt 1 ]]; then
  printf '%s\n' 'ci rtk transport requires a command' >&2
  exit 64
fi

command_name="$1"
shift

# The runtime selector resolves candidate interpreters to absolute paths before
# asking RTK to execute them. Permit only an existing executable whose basename
# is a Python interpreter name; arbitrary absolute commands remain denied.
if [[ "$command_name" == /* ]]; then
  command_base="${command_name##*/}"
  case "$command_base" in
    python|python3|python3.8|python3.9|python3.10|python3.11|python3.12|python3.13|python3.14)
      if [[ ! -x "$command_name" ]]; then
        printf 'ci rtk transport denied non-executable Python path: %s\n' "$command_name" >&2
        exit 64
      fi
      exec "$command_name" "$@"
      ;;
    *)
      printf 'ci rtk transport denied absolute command: %s\n' "$command_name" >&2
      exit 64
      ;;
  esac
fi

case "$command_name" in
  python|python3|python3.8|python3.9|python3.10|python3.11|python3.12|python3.13|python3.14|git|test)
    exec "$command_name" "$@"
    ;;
  bash)
    if [[ $# -lt 1 ]]; then
      printf '%s\n' 'ci rtk transport requires an allowlisted wrapper' >&2
      exit 64
    fi
    script="$1"
    shift
    case "$script" in
      tools/ci/bootstrap-path.sh|tools/knowledge-check.sh|tools/knowledge-regression.sh|tools/knowledge-retrieval-benchmark.sh|tools/knowledge-path-audit.sh)
        exec bash "$script" "$@"
        ;;
      *)
        printf 'ci rtk transport denied wrapper: %s\n' "$script" >&2
        exit 64
        ;;
    esac
    ;;
  *)
    printf 'ci rtk transport denied command: %s\n' "$command_name" >&2
    exit 64
    ;;
esac
