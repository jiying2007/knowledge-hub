#!/usr/bin/env bash
set -euo pipefail

# GitHub-hosted runners do not provide Codex RTK. This least-capability transport
# preserves the repository's governed command invocation contract in CI; it does
# not implement RTK filtering, telemetry, trust, network or shell-eval features.
if [[ $# -lt 1 ]]; then
  printf '%s\n' 'ci rtk transport requires a command' >&2
  exit 64
fi

command_name="$1"
shift

# The runtime selector and engineering gate intentionally resolve Python to an
# absolute path before execution. Accept that path only when its basename is an
# allowlisted Python command and it resolves to the exact interpreter currently
# selected by PATH. This closes the old command-name/absolute-path contract gap
# without turning the CI transport into a generic absolute-command executor.
case "$command_name" in
  /*)
    command_basename="${command_name##*/}"
    case "$command_basename" in
      python|python3|python3.8|python3.9|python3.10|python3.11|python3.12|python3.13|python3.14)
        allowed_python="$(command -v "$command_basename" 2>/dev/null || true)"
        command_real="$(readlink -f "$command_name" 2>/dev/null || true)"
        allowed_real="$(readlink -f "$allowed_python" 2>/dev/null || true)"
        if [[ -z "$allowed_python" || -z "$command_real" || -z "$allowed_real"
              || ! -x "$command_name" || "$command_real" != "$allowed_real" ]]; then
          printf 'ci rtk transport denied absolute python: %s\n' "$command_name" >&2
          exit 64
        fi
        exec "$command_name" "$@"
        ;;
      *)
        printf 'ci rtk transport denied command: %s\n' "$command_name" >&2
        exit 64
        ;;
    esac
    ;;
  python|python3|python3.8|python3.9|python3.10|python3.11|python3.12|python3.13|python3.14|git|test)
    exec "$command_name" "$@"
    ;;
  mkdir)
    # Runtime-selector cache directory only. No generic filesystem creation.
    if [[ $# -eq 2 && "$1" == "-p" && "$2" == /*/.cache/knowledge-hub ]]; then
      exec mkdir -p -- "$2"
    fi
    printf '%s\n' 'ci rtk transport denied mkdir outside runtime cache' >&2
    exit 64
    ;;
  mv)
    # Runtime-selector atomic cache publish only. Source and destination must be
    # in the same private Knowledge Hub cache directory and use the fixed name.
    if [[ $# -eq 3 && "$1" == "-f" ]]; then
      source_path="$2"
      target_path="$3"
      cache_dir="${target_path%/python-runtime-selection-v1}"
      if [[ "$target_path" == /*/.cache/knowledge-hub/python-runtime-selection-v1
            && "$source_path" == "$cache_dir"/python-runtime-selection-v1.*.tmp ]]; then
        exec mv -f -- "$source_path" "$target_path"
      fi
    fi
    printf '%s\n' 'ci rtk transport denied mv outside runtime cache publish' >&2
    exit 64
    ;;
  bash)
    if [[ $# -lt 1 ]]; then
      printf '%s\n' 'ci rtk transport requires an allowlisted wrapper' >&2
      exit 64
    fi
    script="$1"
    shift
    case "$script" in
      tools/ci/bootstrap-path.sh|\
      tools/knowledge-health-summary.sh|\
      tools/knowledge-new.sh|\
      tools/knowledge-search.sh|\
      tools/knowledge-review-after.sh|\
      tools/knowledge-check.sh|\
      tools/knowledge-context.sh|\
      tools/knowledge-evidence-pack.sh|\
      tools/knowledge-map.sh|\
      tools/knowledge-metrics.sh|\
      tools/knowledge-runtime-maintenance.sh|\
      tools/knowledge-restore-drill.sh|\
      tools/knowledge-index-plan.sh|\
      tools/knowledge-source-check.sh|\
      tools/knowledge-link-audit.sh|\
      tools/knowledge-orphan-files.sh|\
      tools/knowledge-obsidian-view-build.sh|\
      tools/knowledge-export.sh|\
      tools/knowledge-reviewing-triage.sh|\
      tools/knowledge-status.sh|\
      tools/knowledge-action-check.sh|\
      tools/knowledge-capture.sh|\
      tools/knowledge-evidence-ledger.sh|\
      tools/knowledge-feedback.sh|\
      tools/knowledge-owner-gates.sh|\
      tools/knowledge-promote.sh|\
      tools/knowledge-proposal-route.sh|\
      tools/knowledge-retire.sh|\
      tools/knowledge-review-attest.sh|\
      tools/knowledge-review-queue-apply.sh|\
      tools/knowledge-pcr02-owner-readiness.sh|\
      tools/knowledge-pcr02-owner-targets.sh|\
      tools/knowledge-artifact-ref-plan.sh|\
      tools/knowledge-artifact-restore-drill.sh|\
      tools/knowledge-compliance-eval.sh|\
      tools/knowledge-engineering-check.sh|\
      tools/knowledge-final-gate.sh|\
      tools/knowledge-project-readiness.sh|\
      tools/knowledge-regression.sh|\
      tools/knowledge-regression-trend.sh|\
      tools/knowledge-retrieval-benchmark.sh|\
      tools/knowledge-doctor.sh|\
      tools/knowledge-inventory.sh|\
      tools/knowledge-path-audit.sh|\
      tools/knowledge-proposal-shadow-stats.sh|\
      tools/knowledge-recovery-audit.sh|\
      tools/knowledge-activity.sh|\
      tools/knowledge-source-control.sh|\
      tools/knowledge-summary-backfill.sh|\
      tools/knowledge-workspace-discover.sh)
        exec bash "$script" "$@"
        ;;
      *)
        printf 'ci rtk transport denied wrapper: %s\n' "$script" >&2
        exit 64
        ;;
    esac
    ;;
  *)
    printf 'ci rtk transport denied command: %s\n' "$command_name" >&2
    exit 64
    ;;
esac
