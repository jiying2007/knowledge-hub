[Unit]
Description=Knowledge Hub report-only daily activity report

[Service]
Type=oneshot
WorkingDirectory=%h/knowledge-hub
Environment=TZ=Asia/Hong_Kong
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
UMask=0077
ExecStart=%h/.local/bin/rtk bash %h/knowledge-hub/tools/knowledge-activity.sh report --period daily --scope personal --codex-root %h/codex --summary-json
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/knowledge-hub/.tmp/activity
RestrictAddressFamilies=AF_UNIX
TimeoutStartSec=10min
