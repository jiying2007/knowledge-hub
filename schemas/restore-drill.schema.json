{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-hub.local/schemas/restore-drill.schema.json",
  "title": "Knowledge Hub restore drill result",
  "type": "object",
  "required": ["schema_version", "status", "source_mode", "source_revision", "candidate_signature", "checks", "cache_included", "local_workspace_mapping_included", "execution_environment", "remote_checkout_verified", "remote_published_ref_verified", "offsite_environment_verified"],
  "properties": {
    "schema_version": {"const": 2},
    "status": {"enum": ["pass", "fail"]},
    "source_mode": {"enum": ["candidate", "head"]},
    "source_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "candidate_signature": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "execution_environment": {
      "type": "object",
      "required": ["provider", "repository", "revision", "event", "runner_environment", "remote_checkout_verified", "remote_published_ref_verified", "offsite_environment_verified"],
      "properties": {
        "provider": {"enum": ["local", "github-actions"]},
        "repository": {"type": "string", "maxLength": 256},
        "revision": {"type": "string", "pattern": "^$|^[a-f0-9]{40}$"},
        "event": {"type": "string", "maxLength": 128},
        "runner_environment": {"type": "string", "maxLength": 128},
        "remote_checkout_verified": {"type": "boolean"},
        "remote_published_ref_verified": {"type": "boolean"},
        "offsite_environment_verified": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "remote_checkout_verified": {"type": "boolean"},
    "remote_published_ref_verified": {"type": "boolean"},
    "offsite_environment_verified": {"type": "boolean"},
    "checks": {"type": "object"},
    "cache_included": {"const": false},
    "local_workspace_mapping_included": {"const": false}
  },
  "additionalProperties": true
}
