{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-hub.local/schemas/restore-drill.schema.json",
  "title": "Knowledge Hub restore drill result",
  "type": "object",
  "required": ["schema_version", "status", "source_mode", "source_revision", "candidate_signature", "checks", "cache_included", "local_workspace_mapping_included"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["pass", "fail"]},
    "source_mode": {"enum": ["candidate", "head"]},
    "source_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "candidate_signature": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "checks": {"type": "object"},
    "cache_included": {"const": false},
    "local_workspace_mapping_included": {"const": false}
  },
  "additionalProperties": true
}
