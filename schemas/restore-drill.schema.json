{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-hub.local/schemas/restore-drill.schema.json",
  "title": "Knowledge Hub restore drill result",
  "type": "object",
  "required": ["schema_version", "status", "source_mode", "source_revision", "candidate_signature", "checks", "cache_included", "local_workspace_mapping_included", "execution_environment", "evidence_matches_current_execution", "remote_checkout_verified", "remote_published_ref_verified", "offsite_environment_verified"],
  "properties": {
    "schema_version": {"const": 4},
    "status": {"enum": ["pass", "needs-fix"]},
    "source_mode": {"enum": ["candidate", "head"]},
    "source_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "candidate_signature": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "execution_environment": {
      "type": "object",
      "required": ["provider", "repository", "expected_repository", "revision", "event", "ref", "runner_environment", "run_id", "run_attempt", "workflow_ref", "workflow_sha", "remote_checkout_verified", "remote_published_ref_verified", "offsite_environment_verified", "trust_contract", "evidence_sha256"],
      "properties": {
        "provider": {"enum": ["local", "github-actions"]},
        "repository": {"type": "string", "maxLength": 256},
        "expected_repository": {"type": "string", "minLength": 1, "maxLength": 256},
        "revision": {"type": "string", "pattern": "^$|^[a-f0-9]{40}$"},
        "event": {"type": "string", "maxLength": 128},
        "ref": {"type": "string", "maxLength": 512},
        "runner_environment": {"type": "string", "maxLength": 128},
        "run_id": {"type": "string", "pattern": "^$|^[0-9]+$"},
        "run_attempt": {"type": "string", "pattern": "^$|^[0-9]+$"},
        "workflow_ref": {"type": "string", "maxLength": 1024},
        "workflow_sha": {"type": "string", "pattern": "^$|^[a-f0-9]{40}$"},
        "remote_checkout_verified": {"type": "boolean"},
        "remote_published_ref_verified": {"type": "boolean"},
        "offsite_environment_verified": {"type": "boolean"},
        "trust_contract": {"const": "github-hosted-matching-revision-current-run-v1"},
        "evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "evidence_matches_current_execution": {"type": "boolean"},
    "remote_checkout_verified": {"type": "boolean"},
    "remote_published_ref_verified": {"type": "boolean"},
    "offsite_environment_verified": {"type": "boolean"},
    "checks": {"type": "object"},
    "cache_included": {"const": false},
    "local_workspace_mapping_included": {"const": false}
  },
  "additionalProperties": true
}
