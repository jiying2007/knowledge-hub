{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://knowledge-hub.local/schemas/provider-workspaces-v1",
  "title":"Logical Provider workspaces independent of Git",
  "type":"object","required":["schema_version","workspaces"],
  "properties":{"schema_version":{"const":1},"workspaces":{"type":"array","items":{"type":"object","required":["workspace_ref","subject_ref"],"properties":{"workspace_ref":{"type":"string","pattern":"^workspace://[a-z0-9][a-z0-9-]{0,80}$"},"subject_ref":{"$ref":"#/$defs/subject"}},"additionalProperties":false}}},
  "$defs":{"subject":{"type":"object","required":["type","id"],"properties":{"type":{"enum":["project","domain","personal","unassigned"]},"id":{"type":"string","minLength":1,"maxLength":160}},"additionalProperties":false}},
  "additionalProperties":false
}
