{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-hub.local/schemas/external-evidence-ratchet-proposal.schema.json",
  "title": "Knowledge Hub external evidence ratchet proposal",
  "type": "object",
  "required": [
    "schema_version",
    "projection",
    "status",
    "authorization_class",
    "review_required",
    "canonical_write_performed",
    "gap_id",
    "expected_registry_sha256",
    "candidate_registry_sha256",
    "closure_receipt_sha256",
    "intake_receipt_sha256",
    "host_binding_sha256",
    "source_revision",
    "intake_revision",
    "generated_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "projection": {
      "const": "knowledge-hub-external-evidence-ratchet-proposal-v2"
    },
    "status": {
      "const": "ready-for-machine-ratchet"
    },
    "authorization_class": {
      "const": "autonomous-low-risk-ratchet"
    },
    "review_required": {
      "const": false
    },
    "canonical_write_performed": {
      "const": false
    },
    "gap_id": {
      "enum": [
        "connector-provider-pilot",
        "production-retrieval-eval",
        "memory-lifecycle-pilot",
        "real-adoption-evidence"
      ]
    },
    "expected_registry_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_registry_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "closure_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "intake_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "host_binding_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "intake_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
