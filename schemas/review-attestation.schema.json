{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-hub.local/schemas/review-attestation.schema.json",
  "title": "Knowledge Hub content review attestation",
  "type": "object",
  "required": [
    "schema_version",
    "form_kind",
    "attestation_id",
    "item_id",
    "reviewed_by",
    "reviewed_at",
    "review_decision",
    "review_basis",
    "validation_refs",
    "attestation_mode",
    "attested_by",
    "attested_at",
    "attestation_source_ref",
    "attestation_statement",
    "attestation_statement_sha256",
    "confirmation_token",
    "content_sha256",
    "expected_before_status",
    "target_status",
    "generated_mechanically",
    "generated_by",
    "execution_authorization_embedded"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "form_kind": {"const": "content-review-attestation"},
    "attestation_id": {"type": "string", "minLength": 1},
    "item_id": {"type": "string", "minLength": 1},
    "reviewed_by": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "format": "date"},
    "review_decision": {"enum": ["accept-active", "retire", "supersede", "reject"]},
    "review_basis": {"type": "string", "minLength": 1},
    "validation_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "attestation_mode": {"enum": ["human-reviewed", "human-directed-delegation"]},
    "attested_by": {"type": "string", "minLength": 1},
    "attested_at": {"type": "string", "format": "date"},
    "attestation_source_ref": {"type": "string", "minLength": 1},
    "attestation_statement": {"type": "string", "minLength": 1},
    "attestation_statement_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "confirmation_token": {"type": "string", "pattern": "^KH-ATTEST-[0-9a-f]{20}$"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expected_before_status": {"type": "string", "minLength": 1},
    "target_status": {"enum": ["active", "archived", "superseded", "rejected"]},
    "generated_mechanically": {"const": true},
    "generated_by": {"const": "knowledge-review-attest"},
    "execution_authorization_embedded": {"const": false},
    "boundaries": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "not": {"required": ["authorization_id"]},
  "additionalProperties": true
}
