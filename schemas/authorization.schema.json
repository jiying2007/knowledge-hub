{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-hub.local/schemas/authorization.schema.json",
  "title": "Knowledge Hub authorization",
  "type": "object",
  "required": [
    "authorization_id", "authorized_by", "authorized_at", "scope", "allowed_actions",
    "expires_at", "evidence_refs", "rollback_path", "validation_commands", "status"
  ],
  "properties": {
    "authorization_id": {"type": "string", "minLength": 1},
    "authorized_by": {"type": "string", "minLength": 1},
    "authorized_at": {"type": "string", "format": "date"},
    "scope": {"type": "string", "minLength": 1},
    "allowed_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "owner-decision-landing", "active-promotion", "memory-write", "source-project-write",
          "automation-apply-with-review", "external-publish", "delete-or-prune", "remote-git-write"
        ]
      }
    },
    "expires_at": {"type": "string", "format": "date"},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "rollback_path": {"type": "string", "minLength": 1},
    "validation_commands": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "status": {"enum": ["active", "expired", "revoked", "used", "superseded"]}
  },
  "additionalProperties": true
}
