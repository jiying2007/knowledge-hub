{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-hub.local/schemas/maintenance-triage.schema.json",
  "title": "Knowledge Hub AI maintenance triage receipt",
  "type": "object",
  "required": [
    "schema_version",
    "projection",
    "status",
    "as_of",
    "read_only",
    "canonical_write_performed",
    "input_digests",
    "ordinary",
    "governance",
    "security",
    "health_status",
    "data_growth_status"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "projection": {"const": "knowledge-hub-ai-maintenance-triage-v1"},
    "status": {"const": "pass"},
    "as_of": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "read_only": {"const": true},
    "canonical_write_performed": {"const": false},
    "input_digests": {"$ref": "#/$defs/inputDigests"},
    "ordinary": {
      "allOf": [
        {"$ref": "#/$defs/group"},
        {
          "properties": {
            "action": {"const": "machine-triaged-no-semantic-write"}
          }
        }
      ]
    },
    "governance": {
      "allOf": [
        {"$ref": "#/$defs/group"},
        {
          "properties": {
            "action": {"const": "machine-review-packet-generated"}
          }
        }
      ]
    },
    "security": {
      "allOf": [
        {"$ref": "#/$defs/group"},
        {
          "properties": {
            "action": {"const": "human-review-required"}
          }
        }
      ]
    },
    "health_status": {"type": "string", "minLength": 1},
    "data_growth_status": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "inputDigests": {
      "type": "object",
      "required": ["review", "growth", "health"],
      "properties": {
        "review": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "growth": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "health": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "row": {
      "type": "object",
      "required": [
        "item_id",
        "path",
        "owner",
        "status",
        "domain",
        "source_id",
        "review_after",
        "days_until_review",
        "review_class",
        "stale_severity",
        "ai_first_action",
        "selection_reason"
      ],
      "properties": {
        "item_id": {"type": "string"},
        "path": {"type": "string"},
        "owner": {"type": "string"},
        "status": {"type": "string"},
        "domain": {"type": "string"},
        "source_id": {"type": "string"},
        "review_after": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "days_until_review": {"type": "integer", "maximum": -1},
        "review_class": {
          "enum": ["ordinary", "governance-critical", "security-critical"]
        },
        "stale_severity": {"type": "string"},
        "ai_first_action": {"type": "string"},
        "selection_reason": {"type": "string"}
      },
      "additionalProperties": false
    },
    "group": {
      "type": "object",
      "required": ["action", "count", "rows"],
      "properties": {
        "action": {"type": "string"},
        "count": {"type": "integer", "minimum": 0},
        "rows": {
          "type": "array",
          "items": {"$ref": "#/$defs/row"}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
