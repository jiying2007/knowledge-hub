{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-hub.local/schemas/provider-principal-v1",
  "title": "Explicit local Provider principal independent of activity reporting",
  "type": "object",
  "required": ["schema_version", "enabled", "principal_id"],
  "properties": {
    "schema_version": {"const": 1}, "enabled": {"type": "boolean"},
    "principal_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,159}$"}
  },
  "additionalProperties": false
}
