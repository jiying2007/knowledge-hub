{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-hub.local/schemas/quality-evidence-binding.schema.json",
  "title": "Knowledge Hub exact-revision Quality evidence binding",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "source_revision",
    "generated_at",
    "evidence",
    "canonical_write"
  ],
  "properties": {
    "schema_version": {"const": "knowledge-hub.quality-evidence-binding.v1"},
    "status": {"const": "pass"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "generated_at": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": {
            "enum": [
              ".tmp/engineering/knowledge-hub.cdx.json",
              ".cache/knowledge-hub/engineering-quality.json",
              ".cache/knowledge-hub/compliance-eval.json",
              ".cache/knowledge-hub/restore-drill-head.json",
              ".cache/knowledge-hub/final-gate-product-full.json"
            ]
          },
          "size": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "canonical_write": {"const": false}
  },
  "additionalProperties": false
}
