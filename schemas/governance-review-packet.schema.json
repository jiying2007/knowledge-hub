{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-hub.local/schemas/governance-review-packet.schema.json",
  "title": "Knowledge Hub governance review packet",
  "type": "object",
  "required": [
    "schema_version",
    "projection",
    "status",
    "as_of",
    "read_only",
    "canonical_write_performed",
    "selection_is_authorization",
    "final_semantic_decision_made",
    "input_digests",
    "review_class",
    "row_count",
    "rows",
    "next_boundary"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "projection": {"const": "knowledge-hub-governance-review-packet-v1"},
    "status": {"enum": ["ready", "no-change"]},
    "as_of": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "read_only": {"const": true},
    "canonical_write_performed": {"const": false},
    "selection_is_authorization": {"const": false},
    "final_semantic_decision_made": {"const": false},
    "input_digests": {
      "type": "object",
      "required": ["review", "growth", "health"],
      "properties": {
        "review": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "growth": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "health": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "review_class": {"const": "governance-critical"},
    "row_count": {"type": "integer", "minimum": 0},
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item_id",
          "path",
          "owner",
          "status",
          "domain",
          "source_id",
          "review_after",
          "days_until_review",
          "review_class",
          "stale_severity",
          "ai_first_action",
          "selection_reason"
        ],
        "properties": {
          "item_id": {"type": "string"},
          "path": {"type": "string"},
          "owner": {"type": "string"},
          "status": {"type": "string"},
          "domain": {"type": "string"},
          "source_id": {"type": "string"},
          "review_after": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "days_until_review": {"type": "integer", "maximum": -1},
          "review_class": {"const": "governance-critical"},
          "stale_severity": {"type": "string"},
          "ai_first_action": {"type": "string"},
          "selection_reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "next_boundary": {"enum": ["machine-review", "none"]}
  },
  "additionalProperties": false
}
