{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-hub.local/schemas/provider-operation-ledger-v4",
  "title": "Immutable Provider operation and independently verified content",
  "type": "object",
  "required": [
    "schema_version",
    "operation_id",
    "request_sha256",
    "action",
    "item_id",
    "created_subject_ref",
    "subject_ref",
    "content_sha256",
    "before_content_sha256",
    "transaction_id",
    "principal_id",
    "verification_basis"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "action": {
      "enum": [
        "archive",
        "assign",
        "metadata"
      ]
    },
    "item_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "created_subject_ref": {
      "$ref": "#/$defs/subject"
    },
    "subject_ref": {
      "$ref": "#/$defs/subject"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "before_content_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "transaction_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 160
    },
    "principal_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 160
    },
    "authorization_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "historical_validation_verified": {
      "const": false
    },
    "verification_basis": {
      "type": "object",
      "required": [
        "kind",
        "proof_ref"
      ],
      "properties": {
        "kind": {
          "enum": [
            "transaction",
            "metadata-transaction",
            "published-snapshot",
            "reviewed-receipt",
            "accepted-current"
          ]
        },
        "proof_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "subject": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "project",
            "domain",
            "personal",
            "unassigned"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
