{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-hub.local/schemas/final-gate-product.schema.json",
  "title": "Knowledge Hub product final gate",
  "type": "object",
  "required": [
    "schema_version",
    "final_profile",
    "platform_status",
    "content_readiness",
    "retrieval_quality",
    "operational_readiness",
    "overall_status",
    "delivery_readiness",
    "local_delivery_complete",
    "remote_published",
    "offsite_restore_verified",
    "adoption_ready",
    "terminal"
  ],
  "properties": {
    "schema_version": {"const": 3},
    "final_profile": {"const": "product"},
    "overall_status": {"enum": ["needs-fix", "needs-owner-review", "partial", "mature"]},
    "local_delivery_complete": {"type": "boolean"},
    "remote_published": {"type": "boolean"},
    "offsite_restore_verified": {"type": "boolean"},
    "adoption_ready": {"type": "boolean"},
    "terminal": {"type": "boolean"},
    "delivery_readiness": {
      "type": "object",
      "required": [
        "local_delivery_complete",
        "remote_published",
        "offsite_restore_verified"
      ],
      "properties": {
        "local_delivery_complete": {"type": "boolean"},
        "remote_published": {"type": "boolean"},
        "offsite_restore_verified": {"type": "boolean"}
      }
    },
    "platform_status": {"type": "object"},
    "content_readiness": {"type": "object"},
    "retrieval_quality": {"type": "object"},
    "operational_readiness": {"type": "object"}
  },
  "additionalProperties": true
}
