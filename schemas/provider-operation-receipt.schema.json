{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-hub.local/schemas/provider-operation-receipt-v2",
  "title": "Provider verified or uncertain subject operation",
  "type": "object",
  "$defs": {
    "hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "subject": {"type": ["object", "null"], "required": ["type", "id"], "properties": {
      "type": {"enum": ["project", "domain", "personal", "unassigned"]},
      "id": {"type": "string", "minLength": 1, "maxLength": 160}
    }, "additionalProperties": false}
  },
  "required": ["schema_version", "status", "persisted", "write_performed", "operation_id", "item_id", "subject_ref", "assignment_state", "project_archived", "candidate_status", "content_sha256", "source_sha256", "transaction_id", "promotion", "active_promoted", "owner_review_performed", "reason_codes"],
  "properties": {
    "schema_version": {"const": "knowledge-provider.operation-receipt/v2"},
    "status": {"enum": ["PLANNED", "BLOCKED", "ARCHIVED", "ALREADY_ARCHIVED", "ASSIGNED", "ALREADY_ASSIGNED", "UNKNOWN", "CONFLICT", "NOT_FOUND", "VERIFIED", "PRESENT_UNVERIFIED"]},
    "persisted": {"type": ["boolean", "null"]},
    "write_performed": {"type": ["boolean", "null"]},
    "operation_id": {"$ref": "#/$defs/hash"},
    "item_id": {"type": ["string", "null"], "maxLength": 128},
    "subject_ref": {"$ref": "#/$defs/subject"},
    "assignment_state": {"enum": ["assigned", "unassigned", null]},
    "project_archived": {"type": "boolean"},
    "candidate_status": {"enum": ["reviewing", "draft", "active", "archived", "superseded", "rejected", "personal", null]},
    "content_sha256": {"$ref": "#/$defs/hash"},
    "source_sha256": {"$ref": "#/$defs/hash"},
    "transaction_id": {"type": ["string", "null"], "maxLength": 160},
    "promotion": {"const": "none"},
    "active_promoted": {"const": false},
    "owner_review_performed": {"const": false},
    "reason_codes": {"type": "array", "maxItems": 8, "items": {"type": "string", "pattern": "^[A-Z][A-Z_]{1,80}$"}},
    "expected_hash": {"$ref": "#/$defs/hash"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"enum": ["ARCHIVED", "ALREADY_ARCHIVED", "ASSIGNED", "ALREADY_ASSIGNED", "VERIFIED"]}}}, "then": {"properties": {"persisted": {"const": true}, "operation_id": {"type": "string"}, "item_id": {"type": "string"}, "content_sha256": {"type": "string"}, "subject_ref": {"type": "object"}}}},
    {"if": {"properties": {"status": {"const": "UNKNOWN"}}}, "then": {"properties": {"persisted": {"const": null}, "write_performed": {"const": null}}}},
    {"if": {"properties": {"status": {"enum": ["PLANNED", "BLOCKED"]}}}, "then": {"properties": {"persisted": {"const": false}, "write_performed": {"const": false}}}},
    {"if": {"properties": {"assignment_state": {"const": "unassigned"}}}, "then": {"properties": {"project_archived": {"const": false}}}}
  ],
  "additionalProperties": false
}
