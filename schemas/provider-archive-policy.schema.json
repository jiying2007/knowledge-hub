{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-hub.local/schemas/provider-archive-policy-v1",
  "title": "Provider candidate archive policy",
  "type": "object",
  "required": ["schema_version", "enabled", "mode", "owner_id", "allowed_kinds", "maximum_bytes"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "enabled": {"type": "boolean"},
    "mode": {"const": "candidate-only"},
    "owner_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "allowed_kinds": {"type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true, "items": {"enum": ["validation", "debug-record", "runbook", "audit", "codex-session", "project-archive", "external-source-note"]}},
    "maximum_bytes": {"type": "integer", "minimum": 1, "maximum": 131072},
    "authorization_basis": {"type": "string", "maxLength": 2048}
  }
}
