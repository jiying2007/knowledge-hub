{
  "schema_version": 1,
  "catalog_id": "knowledge-hub-schema-catalog",
  "contracts": [
    {
      "id": "registry-item-v1",
      "schema": "schemas/item.schema.json",
      "applies_to": "registry/items.jsonl#each-line",
      "authority": "registry",
      "compatibility": "additive-v1"
    },
    {
      "id": "authorization-v1",
      "schema": "schemas/authorization.schema.json",
      "applies_to": "registry/authorizations.jsonl#each-line",
      "authority": "authorization-ledger",
      "compatibility": "additive-v1"
    },
    {
      "id": "lifecycle-event-v1",
      "schema": "schemas/lifecycle-event.schema.json",
      "applies_to": "registry/lifecycle-events.jsonl#each-line",
      "authority": "lifecycle-ledger",
      "compatibility": "additive-v1"
    },
    {
      "id": "frontmatter-mirror-v1",
      "schema": "schemas/frontmatter-mirror.schema.json",
      "applies_to": "managed-markdown#frontmatter",
      "authority": "registry-mirror-only",
      "compatibility": "additive-v1"
    },
    {
      "id": "retrieval-result-v2",
      "schema": "schemas/retrieval-result.schema.json",
      "applies_to": "knowledge-search.sh --json",
      "authority": "derived-local-index",
      "compatibility": "additive-v1"
    },
    {
      "id": "project-readiness-v1",
      "schema": "schemas/project-readiness.schema.json",
      "applies_to": "knowledge-project-readiness.sh --json",
      "authority": "derived-registry-and-local-workspace",
      "compatibility": "additive-v1"
    },
    {
      "id": "local-workspaces-v1",
      "schema": "schemas/local-workspaces.schema.json",
      "applies_to": "local/workspaces.json",
      "authority": "derived-local-git-remote-discovery",
      "compatibility": "additive-v1"
    },
    {
      "id": "final-gate-product-v2",
      "schema": "schemas/final-gate-product.schema.json",
      "applies_to": "knowledge-final-gate.sh --final-profile product --json",
      "authority": "derived-terminal-gate",
      "compatibility": "additive-v1"
    },
    {
      "id": "obsidian-view-build-v1",
      "schema": "schemas/obsidian-view-build.schema.json",
      "applies_to": "knowledge-obsidian-view-build.sh --json",
      "authority": "derived-markdown-view",
      "compatibility": "additive-v1"
    },
    {
      "id": "team-export-v1",
      "schema": "schemas/team-export.schema.json",
      "applies_to": "knowledge-export.sh --json",
      "authority": "derived-local-export",
      "compatibility": "additive-v1"
    },
    {
      "id": "restore-drill-v1",
      "schema": "schemas/restore-drill.schema.json",
      "applies_to": "knowledge-restore-drill.sh --json",
      "authority": "derived-recovery-evidence",
      "compatibility": "additive-v1"
    },
    {
      "id": "local-metrics-v1",
      "schema": "schemas/local-metrics.schema.json",
      "applies_to": "knowledge-metrics.sh --json",
      "authority": "derived-local-telemetry",
      "compatibility": "additive-v1"
    },
    {
      "id": "pcr02-evidence-readiness-v1",
      "schema": "schemas/pcr02-evidence-readiness.schema.json",
      "applies_to": "knowledge-pcr02-owner-readiness.sh --json",
      "authority": "derived-reviewing-contract",
      "compatibility": "additive-v1"
    },
    {
      "id": "project-evidence-contract-v1",
      "schema": "schemas/project-evidence-contract.schema.json",
      "applies_to": "registry/items.jsonl#validation.evidence_contract",
      "authority": "registry",
      "compatibility": "additive-v1"
    }
  ],
  "authority_split": {
    "registry": [
      "id",
      "kind",
      "domain",
      "path",
      "scope",
      "visibility",
      "status",
      "owner",
      "review_after",
      "review_status",
      "promotion"
    ],
    "markdown": [
      "title",
      "summary_zh",
      "tags",
      "aliases",
      "related",
      "body"
    ],
    "mirror_rule": "managed frontmatter mirrors registry identity/lifecycle and must pass drift gate; it never overrides registry state"
  },
  "migration_policy": "field removal or semantic reinterpretation requires an explicit schema migration and contract regression"
}
