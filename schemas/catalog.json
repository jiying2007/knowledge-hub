{
  "schema_version": 1,
  "catalog_id": "knowledge-hub-schema-catalog",
  "contracts": [
    {
      "id": "registry-item-v1",
      "schema": "schemas/item.schema.json",
      "applies_to": "registry/items.jsonl#each-line",
      "authority": "registry",
      "change_policy": "strict-current-contract"
    },
    {
      "id": "agent-contract-v1",
      "schema": "schemas/agent-contract.schema.json",
      "applies_to": "registry/items.jsonl#each-line.agent_contract",
      "authority": "registry-explicit-agent-runtime-contract",
      "change_policy": "strict-current-contract"
    },
    {
      "id": "authorization-v1",
      "schema": "schemas/authorization.schema.json",
      "applies_to": "registry/authorizations.jsonl#each-line",
      "authority": "authorization-ledger",
      "change_policy": "strict-current-contract"
    },
    {
      "id": "review-attestation-v1",
      "schema": "schemas/review-attestation.schema.json",
      "applies_to": "artifacts/manifests/*.local.jsonl generated by knowledge-review-attest.sh",
      "authority": "explicit-human-content-review",
      "change_policy": "strict-current-contract"
    },
    {
      "id": "lifecycle-event-v1",
      "schema": "schemas/lifecycle-event.schema.json",
      "applies_to": "registry/lifecycle-events.jsonl#each-line",
      "authority": "lifecycle-ledger",
      "change_policy": "strict-current-contract"
    },
    {
      "id": "frontmatter-mirror-v1",
      "schema": "schemas/frontmatter-mirror.schema.json",
      "applies_to": "managed-markdown#frontmatter",
      "authority": "registry-mirror-only",
      "change_policy": "strict-current-contract"
    },
    {
      "id": "retrieval-result-v3",
      "schema": "schemas/retrieval-result.schema.json",
      "applies_to": "knowledge-search.sh --json",
      "authority": "derived-local-index",
      "change_policy": "strict-current-contract"
    },
    {
      "id": "knowledge-map-v1",
      "schema": "schemas/knowledge-map.schema.json",
      "applies_to": "knowledge-map.sh --json",
      "authority": "derived-registry-navigation",
      "change_policy": "strict-current-contract"
    },
    {
      "id": "agent-evidence-pack-v1",
      "schema": "schemas/evidence-pack.schema.json",
      "applies_to": "knowledge-evidence-pack.sh --json",
      "authority": "derived-registry-and-search-runtime-view",
      "change_policy": "strict-current-contract"
    },
    {
      "id": "agent-action-check-v1",
      "schema": "schemas/action-check.schema.json",
      "applies_to": "knowledge-action-check.sh --json",
      "authority": "derived-active-explicit-agent-contracts",
      "change_policy": "strict-current-contract"
    },
    {
      "id": "agent-review-policy-v1",
      "schema": "schemas/agent-review-policy.schema.json",
      "applies_to": "registry/agent-review-policy.json",
      "authority": "report-only-shadow-policy",
      "change_policy": "strict-current-contract"
    },
    {
      "id": "agent-proposal-route-v1",
      "schema": "schemas/proposal-route.schema.json",
      "applies_to": "knowledge-proposal-route.sh --json",
      "authority": "derived-report-only-shadow-assessment",
      "change_policy": "strict-current-contract"
    },
    {
      "id": "agent-proposal-shadow-stats-v1",
      "schema": "schemas/proposal-shadow-stats.schema.json",
      "applies_to": "knowledge-proposal-shadow-stats.sh --json",
      "authority": "derived-local-report-only-shadow-audit",
      "change_policy": "strict-current-contract"
    },
    {
      "id": "raw-evidence-inspection-v1",
      "schema": "schemas/raw-evidence-inspection.schema.json",
      "applies_to": "knowledge-evidence-ledger.sh --json",
      "authority": "derived-read-only-external-ledger-metadata",
      "change_policy": "strict-current-contract"
    },
    {
      "id": "artifact-restore-drill-v1",
      "schema": "schemas/artifact-restore-drill.schema.json",
      "applies_to": "knowledge-artifact-restore-drill.sh --json",
      "authority": "derived-isolated-checksum-bound-restore-evidence",
      "change_policy": "strict-current-contract"
    },
    {
      "id": "agent-compliance-eval-v2",
      "schema": "schemas/compliance-eval.schema.json",
      "applies_to": "knowledge-compliance-eval.sh --json",
      "authority": "derived-reproducible-agent-contract-evaluation",
      "change_policy": "strict-current-contract"
    },
    {
      "id": "project-readiness-v1",
      "schema": "schemas/project-readiness.schema.json",
      "applies_to": "knowledge-project-readiness.sh --json",
      "authority": "derived-registry-and-local-workspace",
      "change_policy": "strict-current-contract"
    },
    {
      "id": "local-workspaces-v1",
      "schema": "schemas/local-workspaces.schema.json",
      "applies_to": "local/workspaces.json",
      "authority": "derived-local-git-remote-discovery",
      "change_policy": "strict-current-contract"
    },
    {
      "id": "final-gate-product-v2",
      "schema": "schemas/final-gate-product.schema.json",
      "applies_to": "knowledge-final-gate.sh --final-profile product --json",
      "authority": "derived-terminal-gate",
      "change_policy": "strict-current-contract"
    },
    {
      "id": "obsidian-view-build-v1",
      "schema": "schemas/obsidian-view-build.schema.json",
      "applies_to": "knowledge-obsidian-view-build.sh --json",
      "authority": "derived-markdown-view",
      "change_policy": "strict-current-contract"
    },
    {
      "id": "team-export-v1",
      "schema": "schemas/team-export.schema.json",
      "applies_to": "knowledge-export.sh --json",
      "authority": "derived-local-export",
      "change_policy": "strict-current-contract"
    },
    {
      "id": "restore-drill-v1",
      "schema": "schemas/restore-drill.schema.json",
      "applies_to": "knowledge-restore-drill.sh --json",
      "authority": "derived-recovery-evidence",
      "change_policy": "strict-current-contract"
    },
    {
      "id": "local-metrics-v3",
      "schema": "schemas/local-metrics.schema.json",
      "applies_to": "knowledge-metrics.sh --json",
      "authority": "derived-local-telemetry",
      "change_policy": "strict-current-contract"
    },
    {
      "id": "pcr02-evidence-readiness-v1",
      "schema": "schemas/pcr02-evidence-readiness.schema.json",
      "applies_to": "knowledge-pcr02-owner-readiness.sh --json",
      "authority": "derived-reviewing-contract",
      "change_policy": "strict-current-contract"
    },
    {
      "id": "project-evidence-contract-v1",
      "schema": "schemas/project-evidence-contract.schema.json",
      "applies_to": "registry/items.jsonl#validation.evidence_contract",
      "authority": "registry",
      "change_policy": "strict-current-contract"
    }
  ],
  "authority_split": {
    "registry": [
      "id",
      "kind",
      "domain",
      "path",
      "scope",
      "visibility",
      "status",
      "owner",
      "review_after",
      "review_status",
      "promotion",
      "agent_contract"
    ],
    "markdown": [
      "title",
      "summary_zh",
      "tags",
      "aliases",
      "related",
      "body"
    ],
    "mirror_rule": "managed frontmatter mirrors registry identity/lifecycle and must pass drift gate; it never overrides registry state"
  },
  "schema_change_policy": "runtime accepts only the catalog contract; breaking field or semantic changes require a new contract id and regression evidence"
}
