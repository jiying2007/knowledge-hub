{
  "schema_version": 1,
  "model": "knowledge-hub-review-risk-v1",
  "default_class": "ordinary",
  "classes": {
    "ordinary": {
      "stale_severity": "warning",
      "ai_first_action": "auto-triage"
    },
    "governance-critical": {
      "stale_severity": "needs-review",
      "ai_first_action": "auto-review-packet"
    },
    "security-critical": {
      "stale_severity": "blocked",
      "ai_first_action": "human-review-required"
    }
  },
  "rules": [
    {
      "path": "SECURITY.md",
      "review_class": "security-critical"
    },
    {
      "path": "registry/terminal-closure.json",
      "review_class": "security-critical"
    },
    {
      "path": "registry/ai-operations-policy.json",
      "review_class": "security-critical"
    },
    {
      "path": "registry/knowledge-platform-p5-p10.json",
      "review_class": "security-critical"
    },
    {
      "path": "registry/schema.md",
      "review_class": "security-critical"
    },
    {
      "path": "schemas/catalog.json",
      "review_class": "security-critical"
    },
    {
      "path": "governance/automation-policy.md",
      "review_class": "security-critical"
    },
    {
      "path": "schemas/review-risk-policy.schema.json",
      "review_class": "security-critical"
    },
    {
      "path": "schemas/ai-operations-policy.schema.json",
      "review_class": "security-critical"
    },
    {
      "path": "registry/review-risk-policy.json",
      "review_class": "security-critical"
    },
    {
      "path_prefix": ".github/workflows/",
      "review_class": "security-critical"
    },
    {
      "path": "registry/authorizations.jsonl",
      "review_class": "security-critical"
    },
    {
      "path": "schemas/authorization.schema.json",
      "review_class": "security-critical"
    },
    {
      "path": "tools/codex_assets/knowledge_hub/authorization.py",
      "review_class": "security-critical"
    },
    {
      "path": "tools/codex_assets/knowledge_hub/review_attestation.py",
      "review_class": "security-critical"
    },
    {
      "path": "tools/codex_assets/knowledge_hub/review_risk.py",
      "review_class": "security-critical"
    },
    {
      "path": "tools/codex_assets/knowledge_hub/security_change_review.py",
      "review_class": "security-critical"
    },
    {
      "path": "tools/codex_assets/knowledge_hub/schemas.py",
      "review_class": "security-critical"
    },
    {
      "path": "tools/codex_assets/knowledge_hub/hosting_posture.py",
      "review_class": "security-critical"
    },
    {
      "path": "tools/codex_assets/knowledge_hub/terminal_closure.py",
      "review_class": "security-critical"
    },
    {
      "path": "tools/codex_assets/knowledge_hub/terminal_hosted_evidence.py",
      "review_class": "security-critical"
    },
    {
      "path": "tools/codex_assets/knowledge_hub/repository_private_ratchet.py",
      "review_class": "security-critical"
    },
    {
      "path": "tools/codex_assets/knowledge_hub/operator_auto_route.py",
      "review_class": "security-critical"
    },
    {
      "path": "tools/codex_assets/knowledge_hub/operator_machine_ratchet.py",
      "review_class": "security-critical"
    },
    {
      "path": "tools/codex_assets/knowledge_hub/operator_machine_ratchet_verify.py",
      "review_class": "security-critical"
    },
    {
      "path": "tools/codex_assets/knowledge_hub/external_evidence.py",
      "review_class": "security-critical"
    },
    {
      "path": "tools/codex_assets/knowledge_hub/external_evidence_ratchet.py",
      "review_class": "security-critical"
    },
    {
      "path": "tools/codex_assets/knowledge_hub/external_evidence_ratchet_verify.py",
      "review_class": "security-critical"
    },
    {
      "path_prefix": "governance/",
      "review_class": "governance-critical"
    },
    {
      "path_prefix": "schemas/",
      "review_class": "governance-critical"
    },
    {
      "path_prefix": "registry/",
      "review_class": "governance-critical"
    }
  ]
}
