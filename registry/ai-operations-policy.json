{
  "schema_version": 1,
  "model": "knowledge-hub-ai-first-operations-v1",
  "default_mode": "autonomous-when-machine-verifiable",
  "classes": {
    "autonomous-read": {
      "enabled": true,
      "human_required": false,
      "may_create_pr": false,
      "may_write_canonical_candidate": false,
      "direct_master_write": false,
      "examples": [
        "search",
        "health",
        "discovery",
        "reconciliation",
        "drift detection",
        "freshness checks"
      ]
    },
    "autonomous-proposal": {
      "enabled": true,
      "human_required": false,
      "may_create_pr": true,
      "may_write_canonical_candidate": true,
      "direct_master_write": false,
      "examples": [
        "machine-verifiable evidence binding proposal",
        "contract migration proposal",
        "stale tracker repair proposal"
      ]
    },
    "autonomous-low-risk-ratchet": {
      "enabled": true,
      "human_required": false,
      "may_create_pr": true,
      "may_write_canonical_candidate": true,
      "direct_master_write": false,
      "examples": [
        "repository visibility fact ratchet",
        "immutable provider identity ratchet",
        "machine-only status reconciliation"
      ]
    },
    "human-authorization": {
      "enabled": true,
      "human_required": true,
      "may_create_pr": false,
      "may_write_canonical_candidate": false,
      "direct_master_write": false,
      "examples": [
        "owner decision",
        "active promotion",
        "semantic policy exception",
        "formal release approval",
        "rollback authorization"
      ]
    },
    "real-world-evidence": {
      "enabled": true,
      "human_required": true,
      "may_create_pr": false,
      "may_write_canonical_candidate": false,
      "direct_master_write": false,
      "examples": [
        "device result",
        "production retrieval expectation",
        "real adoption feedback",
        "provider ACL transition"
      ]
    },
    "external-administration": {
      "enabled": true,
      "human_required": true,
      "may_create_pr": false,
      "may_write_canonical_candidate": false,
      "direct_master_write": false,
      "examples": [
        "repository plan change",
        "branch protection administration",
        "organization permission change"
      ]
    }
  },
  "guardrails": {
    "direct_master_write": false,
    "automatic_merge_requires_protected_branch": true,
    "owner_decision_may_be_inferred": false,
    "synthetic_real_world_evidence_allowed": false,
    "machine_ratchet_requires_exact_source": true,
    "machine_ratchet_requires_deterministic_diff": true,
    "automatic_merge_requires_exact_head_quality": true,
    "automatic_merge_requires_same_repository": true,
    "automatic_merge_requires_semantic_allowlist": true,
    "automatic_merge_executes_pr_code": false,
    "automatic_merge_requires_trusted_origin_run": true,
    "automatic_merge_requires_generator_branch_identity": true,
    "machine_ratchet_uses_trusted_run_timestamp": true
  },
  "evidence_binding": {
    "machine_ratchet_fields": [
      "artifact_refs",
      "source_refs",
      "validation_refs"
    ],
    "human_authorization_fields": [
      "release_ref"
    ],
    "machine_ratchet_mutation_intent": "append-reference",
    "machine_ratchet_may_change_owner": false,
    "machine_ratchet_may_change_status": false,
    "machine_ratchet_may_change_readiness": false,
    "machine_ratchet_may_auto_promote_evidence_ready": false,
    "machine_ratchet_may_create_pr": true,
    "machine_ratchet_direct_master_write": false,
    "machine_ratchet_auto_merge_requires_protected_branch": true,
    "machine_ratchet_auto_merge_requires_exact_head_quality": true,
    "machine_ratchet_auto_merge_requires_same_repository": true,
    "machine_ratchet_auto_merge_requires_origin_artifact_digest": true,
    "machine_ratchet_auto_merge_executes_pr_code": false,
    "machine_validation_requires_source_revision_match": true,
    "machine_artifact_kinds": [
      "github-release-asset"
    ],
    "machine_artifact_requires_validation_run_match": false,
    "machine_artifact_requires_source_revision_match": true,
    "machine_artifact_requires_immutable_release": true
  }
}
